# Copy this file to backend/.env for local development or your deployment platform settings.
# This example file is a template only. It is not loaded automatically at runtime.

# ----------------------------------
# Local preview mode
# ----------------------------------
PORT=5000
NODE_ENV=development

# Supabase runtime connection used by the app server.
# Replace PROJECT_REF with your Supabase project ref and YOUR_PASSWORD with your database password.
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres?pgbouncer=true&connection_limit=1&sslmode=require"

# Supabase Prisma migration connection.
# Prisma migrate commands should use a direct database URL when possible.
# If your platform cannot reach the direct host, you may reuse the pooled connection string.
DIRECT_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require"

# CLIENT_URL, FRONTEND_URL, and APP_BASE_URL are single canonical frontend URLs.
# CORS_ORIGINS is the comma-separated browser allowlist.
# Include your production domains and any localhost ports you use during development.
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
APP_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,https://www.comlabreservation.app,https://comlabreservation.app

JWT_SECRET=replace_me_with_a_long_random_secret
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=replace_me_with_a_second_long_random_secret
JWT_REFRESH_EXPIRES_IN=7d

AUTH_COOKIE_NAME=comlab_access_token
AUTH_COOKIE_MAX_AGE_MS=86400000
REFRESH_COOKIE_NAME=comlab_refresh_token
REFRESH_COOKIE_MAX_AGE_MS=604800000
AUTH_COOKIE_SAME_SITE=lax

RESET_TOKEN_TTL_MINUTES=30
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24
RESET_TOKEN_PREVIEW=true
ENABLE_DEMO_BOOTSTRAP=false
# Set this to false on extra API replicas so reminders and notification workers run only once.
ENABLE_BACKGROUND_WORKERS=true
NOTIFICATION_EMAIL_PREVIEW=true

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ComPort Laboratory Portal <your_verified_sender@example.com>"
SMTP_FROM_EMAIL=your_verified_sender@example.com
SMTP_FROM_NAME=ComPort Laboratory Portal

AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_API_BASE_URL=
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=ComPort

RESERVATION_REMINDER_LEAD_MINUTES=60
RESERVATION_REMINDER_INTERVAL_MS=60000
LOGIN_RATE_LIMIT_WINDOW_MS=60000
LOGIN_RATE_LIMIT_MAX=5
REGISTER_RATE_LIMIT_WINDOW_MS=60000
REGISTER_RATE_LIMIT_MAX=5
FORGOT_PASSWORD_RATE_LIMIT_WINDOW_MS=60000
FORGOT_PASSWORD_RATE_LIMIT_MAX=5
RESET_PASSWORD_RATE_LIMIT_WINDOW_MS=60000
RESET_PASSWORD_RATE_LIMIT_MAX=5
VERIFY_EMAIL_RATE_LIMIT_WINDOW_MS=60000
VERIFY_EMAIL_RATE_LIMIT_MAX=10
RESEND_VERIFICATION_RATE_LIMIT_WINDOW_MS=60000
RESEND_VERIFICATION_RATE_LIMIT_MAX=5
AI_ASSISTANT_RATE_LIMIT_WINDOW_MS=60000
AI_ASSISTANT_RATE_LIMIT_MAX=12

# ----------------------------------
# Production example
# ----------------------------------
# NODE_ENV=production
# CLIENT_URL=https://www.comlabreservation.app
# FRONTEND_URL=https://www.comlabreservation.app
# APP_BASE_URL=https://www.comlabreservation.app
# CORS_ORIGINS=https://www.comlabreservation.app,https://comlabreservation.app
# AUTH_COOKIE_SAME_SITE=none
# RESET_TOKEN_PREVIEW=false
# ENABLE_BACKGROUND_WORKERS=true
# NOTIFICATION_EMAIL_PREVIEW=false
# SMTP_HOST=your_smtp_host
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_smtp_user
# SMTP_PASS=your_smtp_password
# SMTP_FROM="ComPort Laboratory Portal <your_verified_sender@example.com>"
# SMTP_FROM_EMAIL=your_verified_sender@example.com
# SMTP_FROM_NAME=ComPort Laboratory Portal
# AI_PROVIDER=groq
# AI_API_KEY=your_groq_key
# AI_MODEL=llama-3.1-8b-instant
# OPENROUTER_SITE_URL=https://your-frontend-domain.com
# OPENROUTER_APP_NAME=ComPort
